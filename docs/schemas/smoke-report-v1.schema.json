{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ekd.invalid/schemas/smoke-report-v1.schema.json",
  "title": "P0 crypto smoke report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "timestamp_utc",
    "git_commit",
    "candidate",
    "algorithm_suite",
    "environment",
    "test_vectors",
    "required_vector_counts",
    "vector_results",
    "process",
    "aggregate",
    "environment_manifest",
    "raw_artifacts",
    "device_binding"
  ],
  "properties": {
    "schema_version": {"const": "smoke-report-v1"},
    "run_id": {"type": "string", "format": "uuid"},
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "package_integrity", "bundle_sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "package_integrity": {"type": "string", "minLength": 1},
        "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "algorithm_suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "suite_id", "key_length_bytes", "nonce_length_bytes", "tag_length_bytes", "aad_contract"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "suite_id": {"type": "integer", "minimum": 0, "maximum": 255},
        "key_length_bytes": {"type": "integer", "minimum": 16, "maximum": 64},
        "nonce_length_bytes": {"type": "integer", "minimum": 8, "maximum": 32},
        "tag_length_bytes": {"type": "integer", "minimum": 12, "maximum": 32},
        "aad_contract": {"const": "ekd-object-aad-v1-101-bytes"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "os_name", "os_version", "runtime_name", "runtime_version",
        "device_model", "architecture", "lockfile_sha256", "source_commit", "bundle_sha256"
      ],
      "properties": {
        "id": {"enum": ["windows-node-cli", "windows-obsidian", "android-obsidian"]},
        "os_name": {"type": "string", "minLength": 1},
        "os_version": {"type": "string", "minLength": 1},
        "runtime_name": {"type": "string", "minLength": 1},
        "runtime_version": {"type": "string", "minLength": 1},
        "device_model": {"type": ["string", "null"]},
        "architecture": {"type": "string", "minLength": 1},
        "lockfile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "test_vectors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_path", "manifest_sha256", "vector_count", "vectors_sha256"],
      "properties": {
        "manifest_path": {"type": "string", "minLength": 1},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "vector_count": {"type": "integer", "minimum": 14},
        "vectors_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "required_vector_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aead_kat", "aead_tamper_ciphertext", "aead_tamper_tag", "aead_tamper_nonce",
        "aead_tamper_aad", "hkdf_kat", "hkdf_info_isolation", "random_roundtrip",
        "random_source_errors", "wrap_kat", "wrap_bad_material"
      ],
      "properties": {
        "aead_kat": {"const": 3},
        "aead_tamper_ciphertext": {"const": 1},
        "aead_tamper_tag": {"const": 1},
        "aead_tamper_nonce": {"const": 1},
        "aead_tamper_aad": {"const": 1},
        "hkdf_kat": {"const": 2},
        "hkdf_info_isolation": {"const": 1},
        "random_roundtrip": {"const": 1},
        "random_source_errors": {"const": 1},
        "wrap_kat": {"const": 1},
        "wrap_bad_material": {"const": 1}
      }
    },
    "vector_results": {
      "type": "array",
      "minItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "vector_id", "category", "required", "status", "expected_sha256", "actual_sha256",
          "expected_error_codes", "actual_error_code", "duration_ms", "peak_rss_bytes"
        ],
        "properties": {
          "vector_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "category": {
            "enum": [
              "aead-kat", "aead-tamper-ciphertext", "aead-tamper-tag", "aead-tamper-nonce",
              "aead-tamper-aad", "hkdf-kat", "hkdf-info-isolation", "random-roundtrip",
              "random-source-errors", "wrap-kat", "wrap-bad-material", "perf-micro", "candidate-specific"
            ]
          },
          "required": {"type": "boolean"},
          "status": {"enum": ["passed", "failed", "error", "skipped"]},
          "expected_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "actual_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "expected_error_codes": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
            "uniqueItems": true
          },
          "actual_error_code": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]*$"},
          "duration_ms": {"type": "number", "minimum": 0},
          "peak_rss_bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exit_code", "timed_out", "uncaught_error"],
      "properties": {
        "exit_code": {"type": "integer"},
        "timed_out": {"type": "boolean"},
        "uncaught_error": {"type": ["string", "null"]}
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "required_total", "passed", "failed", "error", "skipped", "required_passed", "verdict"],
      "properties": {
        "total": {"type": "integer", "minimum": 14},
        "required_total": {"const": 14},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "error": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0},
        "required_passed": {"type": "integer", "minimum": 0, "maximum": 14},
        "verdict": {"enum": ["pass", "fail", "incomplete"]}
      }
    },
    "environment_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recorded_at", "items_sha256", "items"],
      "properties": {
        "recorded_at": {"type": "string", "format": "date-time"},
        "items_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "items": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "value"],
            "properties": {
              "key": {"type": "string", "minLength": 1},
              "value": {"type": "string"}
            }
          }
        }
      }
    },
    "raw_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "device_binding": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "signature_algorithm", "public_key_fingerprint", "device_signature_base64url",
            "run_id", "vector_manifest_sha256", "plugin_bundle_sha256", "verified"
          ],
          "properties": {
            "signature_algorithm": {"type": "string", "minLength": 1},
            "public_key_fingerprint": {"type": "string", "minLength": 1},
            "device_signature_base64url": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
            "run_id": {"type": "string", "format": "uuid"},
            "vector_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "plugin_bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "verified": {"type": "boolean"}
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"environment": {"properties": {"id": {"const": "android-obsidian"}}}}},
      "then": {
        "properties": {
          "environment": {"properties": {"device_model": {"type": "string", "minLength": 1}}},
          "device_binding": {"type": "object", "properties": {"verified": {"const": true}}}
        }
      },
      "else": {"properties": {"device_binding": {"type": "null"}}}
    },
    {
      "properties": {
        "vector_results": {
          "contains": {"type": "object", "required": ["required"], "properties": {"required": {"const": true}}},
          "minContains": 14,
          "maxContains": 14
        }
      }
    },
    {
      "properties": {
        "vector_results": {
          "contains": {"type": "object", "required": ["required", "category"], "properties": {"required": {"const": true}, "category": {"const": "aead-kat"}}},
          "minContains": 3,
          "maxContains": 3
        }
      }
    },
    {
      "properties": {
        "vector_results": {
          "contains": {"type": "object", "required": ["required", "category"], "properties": {"required": {"const": true}, "category": {"const": "aead-tamper-ciphertext"}}},
          "minContains": 1,
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "vector_results": {
          "contains": {"type": "object", "required": ["required", "category"], "properties": {"required": {"const": true}, "category": {"const": "aead-tamper-tag"}}},
          "minContains": 1,
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "vector_results": {
          "contains": {"type": "object", "required": ["required", "category"], "properties": {"required": {"const": true}, "category": {"const": "aead-tamper-nonce"}}},
          "minContains": 1,
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "vector_results": {
          "contains": {"type": "object", "required": ["required", "category"], "properties": {"required": {"const": true}, "category": {"const": "aead-tamper-aad"}}},
          "minContains": 1,
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "vector_results": {
          "contains": {"type": "object", "required": ["required", "category"], "properties": {"required": {"const": true}, "category": {"const": "hkdf-kat"}}},
          "minContains": 2,
          "maxContains": 2
        }
      }
    },
    {
      "properties": {
        "vector_results": {
          "contains": {"type": "object", "required": ["required", "category"], "properties": {"required": {"const": true}, "category": {"const": "hkdf-info-isolation"}}},
          "minContains": 1,
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "vector_results": {
          "contains": {"type": "object", "required": ["required", "category"], "properties": {"required": {"const": true}, "category": {"const": "random-roundtrip"}}},
          "minContains": 1,
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "vector_results": {
          "contains": {"type": "object", "required": ["required", "category"], "properties": {"required": {"const": true}, "category": {"const": "random-source-errors"}}},
          "minContains": 1,
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "vector_results": {
          "contains": {"type": "object", "required": ["required", "category"], "properties": {"required": {"const": true}, "category": {"const": "wrap-kat"}}},
          "minContains": 1,
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "vector_results": {
          "contains": {"type": "object", "required": ["required", "category"], "properties": {"required": {"const": true}, "category": {"const": "wrap-bad-material"}}},
          "minContains": 1,
          "maxContains": 1
        }
      }
    }
  ]
}
