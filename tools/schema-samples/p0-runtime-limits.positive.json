      "large-minus-small peak RSS at or below 134217728 bytes",
      "RSS sampling interval at or below 100 milliseconds"
    ],
    "acc29_peak_rss_max_bytes": 536870912,
    "acc30_large_minus_small_peak_rss_max_bytes": 134217728,
    "rss_sampling_interval_max_ms": 100
