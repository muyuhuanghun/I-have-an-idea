{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useDefineForClassFields": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@ekd/core": ["packages/core/src/index.ts"],
      "@ekd/crypto": ["packages/crypto/src/index.ts"],
      "@ekd/crypto/*": ["packages/crypto/src/*.ts"],
      "@ekd/smoke": ["packages/smoke/src/index.ts"],
      "@ekd/smoke/*": ["packages/smoke/src/*.ts"],
      "@ekd/adapters": ["packages/adapters/src/index.ts"]
    }
  }
}
